# cost-engine is usable with no environment at all. These are optional.

# Opt in to the Claude-generated executive summary. Without this, a
# deterministic template fills the same slot.
# ANTHROPIC_API_KEY=sk-ant-...

# Override the summary model (defaults to the cheapest Haiku tier).
# COST_ENGINE_LLM_MODEL=claude-haiku-4-5-20251001

# Phase 2 real connectors use the standard AWS credential chain. Prefer a named
# profile or an instance role with a read-only billing/Cost Explorer policy.
# Do not commit real keys; this file is an example only.
# AWS_PROFILE=cost-readonly
# AWS_REGION=us-east-2
